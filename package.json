{
  "name": "roofing-website-template",
  "version": "1.0.0",
  "description": "White-label roofing contractor template for the Whop Workforce bounty",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "whop": "whop",
    "build:whop": "vite build",
    "dev:whop": "vite --host 127.0.0.1 --port 3101",
    "deploy:whop": "npm run build:whop && whop apps deploy --skip_build true",
    "preview:whop": "vite preview --host 127.0.0.1 --port 3101",
    "test:ui": "vitest run --config vitest.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@whop/elements": "^1.10.0",
    "@whop/elements-react": "^1.10.0",
    "lucide-react": "^1.72.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@whop/cli": "^1.0.0",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  },
  "private": true
}
